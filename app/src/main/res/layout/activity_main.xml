<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="Desafio Practico 01"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/promedioBtn"
        android:layout_width="164dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:text="Promedio estudiante" />

    <Button
        android:id="@+id/salarioBtn"
        android:layout_width="164dp"
        android:layout_height="50dp"
        android:layout_marginBottom="12dp"
        android:text="Descuentos al Salario" />

    <Button
        android:id="@+id/calculadoraBtn"
        android:layout_width="164dp"
        android:layout_height="50dp"
        android:text="Calculadora Básica" />

</androidx.appcompat.widget.LinearLayoutCompat>